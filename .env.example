# Server / AnythingLLM
PORT=3001
# Only include STORAGE_DIR if you're using bind mounts (see compose)
STORAGE_DIR=/app/server/storage

# If you proxy A-LLM with your own backend, include those here too:
# ALLM_BASE=http://anythingllm:3001
# ALLM_KEY=        # set in your running instance, NOT committed
# WORKSPACE_SLUG=  # fill at runtime or via deployment env
