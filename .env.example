# --- Logging ---
# Local directory for JSONL query logs (relative to project root)
LOG_DIR=logs
# S3 bucket for log uploads (create this bucket in AWS Console before using)
LOG_S3_BUCKET=ragatini-logs
# Key prefix inside the bucket (logs land at s3://LOG_S3_BUCKET/LOG_S3_PREFIX/YYYY/MM/DD/)
LOG_S3_PREFIX=query-logs
